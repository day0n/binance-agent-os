APP_ORIGIN=http://localhost:3000
# Generate at least 32 random bytes (hex): openssl rand -hex 32
APP_SECRET=
# Extra password pepper. Production must set this independently of APP_SECRET.
AUTH_PEPPER=
MONGODB_URI=
MONGODB_DB=binance_agent_os_dev
REDIS_URL=
# Optional isolated Vercel Marketplace Redis. When set, this takes precedence
# over REDIS_URL so a stale reference connection cannot break production.
BAO_REDIS_URL=
APP_ENV=development
# Default provider: Gemini on Vertex AI. Base64 service-account JSON, server only.
GOOGLE_OC_JSON=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_THINKING_LEVEL=HIGH
GEMINI_MAX_OUTPUT_TOKENS=32768
# Optional per-role model IDs within the selected provider; no silent fallback.
ROLE_MODELS_JSON={}
# Optional alternative providers, never automatically selected.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-sonnet-4-6
# HTTPS URL serving this app's client metadata; required for localhost OAuth.
BINANCE_CLIENT_METADATA_URL=
# Audited exact tool-name mapping. Empty = fail closed, never guessed at runtime.
# See docs/MCP.md. Populate only after tools/list and schema review.
BINANCE_TOOL_BINDINGS_JSON={}
# Write switches default off. Env can only lower the 5 / 20 USDT hard caps.
BINANCE_WRITES_ENABLED=false
BINANCE_PRODUCTION_WRITES_ENABLED=false
ACTION_MAX_USDT=5
ACTION_DAILY_MAX_USDT=20
# Cloud Run Executor + WIF + KMS. Leave empty until the private executor exists.
EXECUTOR_URL=
EXECUTOR_GCP_PROJECT=
GCP_WIF_PROVIDER=
GCP_WIF_SERVICE_ACCOUNT=
KMS_KEY_RESOURCE=
KMS_PUBLIC_KEY=
RUN_MAX_MODEL_CALLS=24
RUN_MAX_TOOL_CALLS=36
RUN_MAX_TOKENS=60000
RUN_TIMEOUT_SECONDS=600
OWNER_DAILY_RUN_LIMIT=20
VERCEL_DEPLOY_SCOPE=niuzj0-5483s-projects
VERCEL_EXPECTED_ORG_ID=
